{
  "name": "split",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "check": "run-s check:*",
    "check:oxlint": "oxlint .",
    "check:eslint": "eslint .",
    "check:format": "prettier --check src/",
    "format": "prettier --write --experimental-cli src/",
    "audit": "npm audit --omit=dev",
    "pattern": "node scripts/generate-pattern.js",
    "og-image": "node scripts/render-og-image.js",
    "demo": "node scripts/demo/record.js"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "async-mutex": "^0.5.0",
    "copy-to-clipboard": "^4.0.2",
    "fflate": "^0.8.3",
    "quasar": "^2.35.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.12.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "prettier": "3.9.10",
    "sass-embedded": "^1.108.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
