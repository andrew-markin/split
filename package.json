{
  "name": "split",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "check": "run-s check:*",
    "check:oxlint": "oxlint .",
    "check:eslint": "eslint .",
    "check:format": "prettier --check src/",
    "format": "prettier --write --experimental-cli src/",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "async-mutex": "^0.5.0",
    "copy-to-clipboard": "^4.0.2",
    "fflate": "^0.8.3",
    "quasar": "^2.32.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "~1.83.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.83.0",
    "prettier": "3.9.7",
    "sass-embedded": "^1.104.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
